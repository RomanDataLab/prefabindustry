{
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "ALLOW-FROM https://realdatalab.github.io" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://realdatalab.github.io" }
      ]
    }
  ]
}
